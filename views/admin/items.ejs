<p class="mb-1">
  <a href="/admin/textbooks">&larr; 课本列表</a> →
  <a href="/admin/textbooks/<%= textbook.id %>/units"><%= textbook.name %></a> →
  <strong><%= unit.name %></strong>
</p>
<h1><%= unit.name %></h1>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>
<% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success"><%= success %></div>
<% } %>

<!-- Single item form -->
<form method="POST" action="/admin/units/<%= unit.id %>/items" class="mb-2" style="background:#fff;padding:1rem;border-radius:8px;box-shadow:0 1px 4px rgba(0,0,0,0.06);">
  <h3 class="mb-1">添加条目</h3>
  <div class="form-group">
    <label>类型</label>
    <select id="item-type" name="type" required>
      <option value="word">单词 (word)</option>
      <option value="phrase">短语 (phrase)</option>
      <option value="grammar">语法 (grammar)</option>
    </select>
  </div>
  <div data-type-panel="lexical">
    <div class="form-group"><input type="text" name="english" placeholder="英文"></div>
    <div class="form-group"><input type="text" name="chinese" placeholder="中文释义"></div>
    <div class="form-group"><input type="text" name="pos" placeholder="词性（可选）"></div>
    <div class="form-group">
      <label for="example">例句（可选）</label>
      <input type="text" id="example" name="example" placeholder="例句（可选）">
      <div id="extra-examples" class="mt-2"></div>
      <button type="button" id="add-example-btn" class="btn btn-sm mt-2" hidden>增加例句</button>
    </div>
  </div>

  <section data-type-panel="grammar" hidden>
    <h3>语法知识结构</h3>
    <div class="form-group">
      <label>语法标题</label>
      <input type="text" name="grammar_detail[title]" placeholder="例如：一般过去时">
    </div>
    <div class="form-group">
      <label>语法说明</label>
      <textarea name="grammar_detail[description]" rows="4" placeholder="说明这个语法点的核心用法"></textarea>
    </div>
    <div class="form-group">
      <label>使用规则</label>
      <textarea name="grammar_detail[usage_notes]" rows="3" placeholder="常见时间状语、结构、易错点等"></textarea>
    </div>

    <h3>语法例题</h3>
    <div id="grammar-examples">
      <div class="grammar-example-row" data-grammar-example-row>
        <div class="form-group">
          <label>例题类型</label>
          <select name="grammar_examples[0][example_type]">
            <option value="choice">单项选择</option>
            <option value="completion">完成句子</option>
            <option value="sentence_transform">句型转换</option>
          </select>
        </div>
        <div class="form-group">
          <label>题干</label>
          <textarea name="grammar_examples[0][prompt_text]" rows="3" placeholder="例如：He ____ (buy) a bike yesterday."></textarea>
        </div>
        <div class="form-group">
          <label>选项，每行一个，只有单项选择需要填写</label>
          <textarea name="grammar_examples[0][options_text]" rows="4" placeholder="A. buy&#10;B. buys&#10;C. bought&#10;D. buying"></textarea>
        </div>
        <div class="form-group">
          <label>标准答案</label>
          <input type="text" name="grammar_examples[0][answer_text]" placeholder="例如：bought">
        </div>
        <div class="form-group">
          <label>例题解析</label>
          <textarea name="grammar_examples[0][explanation]" rows="3" placeholder="说明这道题如何应用该语法点"></textarea>
        </div>
      </div>
    </div>
    <button type="button" id="add-grammar-example-btn" class="btn btn-sm mt-2">增加语法例题</button>
  </section>

  <button type="submit" class="btn btn-primary">添加</button>
</form>

<script>
(() => {
  const typeSelect = document.getElementById('item-type');
  const addButton = document.getElementById('add-example-btn');
  const addGrammarExampleButton = document.getElementById('add-grammar-example-btn');
  const extraExamples = document.getElementById('extra-examples');
  const lexicalPanel = document.querySelector('[data-type-panel="lexical"]');
  const grammarPanel = document.querySelector('[data-type-panel="grammar"]');
  const grammarExamples = document.getElementById('grammar-examples');

  function setPanelDisabled(panel, disabled) {
    panel.querySelectorAll('input, textarea, select, button').forEach((field) => {
      field.disabled = disabled;
    });
  }

  function updateTypePanels() {
    const isPhrase = typeSelect.value === 'phrase';
    const isGrammar = typeSelect.value === 'grammar';
    lexicalPanel.hidden = isGrammar;
    grammarPanel.hidden = !isGrammar;
    setPanelDisabled(lexicalPanel, isGrammar);
    setPanelDisabled(grammarPanel, !isGrammar);
    addButton.hidden = !isPhrase;
    if (!isPhrase) {
      extraExamples.replaceChildren();
    }
  }

  addButton.addEventListener('click', () => {
    const wrapper = document.createElement('div');
    wrapper.className = 'form-group';

    const input = document.createElement('input');
    input.type = 'text';
    input.name = 'examples[]';
    input.placeholder = '增加一个短语例句';

    wrapper.appendChild(input);
    extraExamples.appendChild(wrapper);
    input.focus();
  });

  addGrammarExampleButton.addEventListener('click', () => {
    const index = grammarExamples.querySelectorAll('[data-grammar-example-row]').length;
    const source = grammarExamples.querySelector('[data-grammar-example-row]');
    const clone = source.cloneNode(true);
    clone.querySelectorAll('input, textarea, select').forEach((field) => {
      field.name = field.name.replace(/grammar_examples\[\d+\]/, `grammar_examples[${index}]`);
      if (field.tagName === 'SELECT') {
        field.value = 'choice';
      } else {
        field.value = '';
      }
    });
    grammarExamples.appendChild(clone);
    clone.querySelector('select').focus();
  });

  typeSelect.addEventListener('change', updateTypePanels);
  updateTypePanels();
})();
</script>

<!-- Batch import -->
<details class="mb-2" style="background:#fff;padding:1rem;border-radius:8px;box-shadow:0 1px 4px rgba(0,0,0,0.06);">
  <summary style="cursor:pointer;font-weight:bold;">批量导入</summary>
  <form method="POST" action="/admin/items/batch" style="margin-top:0.5rem;">
    <input type="hidden" name="unit_id" value="<%= unit.id %>">
    <div class="form-group">
      <label>每行一条，支持：英文 | 中文 | 类型 | 词性(可选) | 例句(可选)，或单词格式：英文 | 音标 | 中文 | 词性(可选) | 例句(可选)</label>
      <textarea name="data" rows="6" placeholder="apple | 苹果 | word | 名词 | I like apples&#10;director | dɪˈrektə | 导演 | n，名词 |"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">批量导入</button>
  </form>
</details>

<details class="mb-2" style="background:#fff;padding:1rem;border-radius:8px;box-shadow:0 1px 4px rgba(0,0,0,0.06);">
  <summary style="cursor:pointer;font-weight:bold;">单词 Excel 导入</summary>
  <p class="text-muted mt-1">请使用固定列标题的 .xlsx 文件导入单词及其题型扩展信息。</p>
  <p class="mt-1">
    <a href="/admin/units/<%= unit.id %>/word-import-template" class="btn">下载单词导入模板</a>
  </p>
  <form method="POST" action="/admin/units/<%= unit.id %>/word-import" enctype="multipart/form-data" style="margin-top:0.5rem;">
    <div class="form-group">
      <label for="word-excel">选择 .xlsx 文件</label>
      <input type="file" id="word-excel" name="word_excel" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required>
    </div>
    <button type="submit" class="btn btn-primary">导入单词 Excel</button>
  </form>
</details>

<!-- Items list -->
<% if (items.length === 0) { %>
  <p class="text-muted">暂无条目</p>
<% } else { %>
  <table>
    <thead>
      <tr><th>类型</th><th>英文</th><th>中文</th><th>操作</th></tr>
    </thead>
    <tbody>
    <% items.forEach(item => { %>
      <tr>
        <td><%= item.type %></td>
        <td><%= item.english || '-' %></td>
        <td><%= item.chinese || '-' %></td>
        <td>
          <a href="/admin/items/<%= item.id %>/edit" class="btn btn-sm btn-primary">编辑</a>
          <form method="POST" action="/admin/items/<%= item.id %>/delete" style="display:inline;"
                onsubmit="return confirm('确定删除？')">
            <button type="submit" class="btn btn-sm btn-danger">删除</button>
          </form>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
<% } %>
