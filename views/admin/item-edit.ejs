<%
  const wordDetail = wordQuestionDetail || {};
  const wordInflections = wordDetail.inflections || {};
  const sentenceDetail = sentenceOrderDetail || {};
  const sentenceTokensText = Array.isArray(sentenceDetail.tokens) ? sentenceDetail.tokens.join(' ') : '';
  const phraseRows = (phraseChoiceQuestions || []).map((row) => ({
    id: row.id,
    prompt_sentence: row.prompt_sentence || '',
    correct_phrase: row.correct_phrase || '',
    distractor_a: row.distractor_a || '',
    distractor_b: row.distractor_b || '',
    distractor_c: row.distractor_c || '',
    explanation: row.explanation || '',
  }));
  phraseRows.push({
    id: '',
    prompt_sentence: '',
    correct_phrase: '',
    distractor_a: '',
    distractor_b: '',
    distractor_c: '',
    explanation: '',
  });
  const grammarDetailView = grammarDetail || {};
  const grammarRows = (grammarExamples && grammarExamples.length ? grammarExamples : [{
    example_type: 'choice',
    prompt_text: '',
    options: [],
    answer_text: '',
    explanation: '',
  }]).map((rawRow) => {
    const row = rawRow || {};
    return {
      example_type: row.example_type || 'choice',
      prompt_text: row.prompt_text || '',
      options_text: row.options_text || (Array.isArray(row.options) ? row.options.join('\n') : ''),
      answer_text: row.answer_text || '',
      explanation: row.explanation || '',
    };
  });
%>

<p class="mb-1">
  <a href="/admin/textbooks">&larr; 课本列表</a> →
  <a href="/admin/textbooks/<%= textbook.id %>/units"><%= textbook.name %></a> →
  <a href="/admin/units/<%= unit.id %>/items"><%= unit.name %></a> →
  <strong>编辑条目</strong>
</p>
<h1>编辑条目</h1>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>

<form method="POST" action="/admin/items/<%= item.id %>/edit" style="background:#fff;padding:1rem;border-radius:8px;">
  <div class="form-group">
    <label>类型</label>
    <select name="type" required>
      <option value="word" <%= item.type === 'word' ? 'selected' : '' %>>单词</option>
      <option value="phrase" <%= item.type === 'phrase' ? 'selected' : '' %>>短语</option>
      <option value="grammar" <%= item.type === 'grammar' ? 'selected' : '' %>>语法</option>
    </select>
  </div>
  <div class="form-group"><label>英文</label><input type="text" name="english" value="<%= item.english || '' %>"></div>
  <div class="form-group"><label>中文</label><input type="text" name="chinese" value="<%= item.chinese || '' %>"></div>
  <div class="form-group"><label>词性</label><input type="text" name="pos" value="<%= item.pos || '' %>"></div>
  <div class="form-group"><label>例句</label><input type="text" name="example" value="<%= item.example || '' %>"></div>

  <% if (item.type === 'word') { %>
    <h2>题型扩展信息</h2>
    <div class="form-group"><label>原形</label><input type="text" name="word_detail[base_form]" value="<%= wordDetail.base_form || '' %>"></div>
    <div class="form-group"><label>首字母提示</label><input type="text" name="word_detail[first_letter_hint]" value="<%= wordDetail.first_letter_hint || '' %>"></div>
    <div class="form-group"><label>用法说明</label><input type="text" name="word_detail[usage_note]" value="<%= wordDetail.usage_note || '' %>"></div>
    <div class="form-group"><label>复数</label><input type="text" name="word_detail[plural]" value="<%= wordInflections.plural || '' %>"></div>
    <div class="form-group"><label>第三人称单数</label><input type="text" name="word_detail[third_person_singular]" value="<%= wordInflections.third_person_singular || '' %>"></div>
    <div class="form-group"><label>过去式</label><input type="text" name="word_detail[past_tense]" value="<%= wordInflections.past_tense || '' %>"></div>
    <div class="form-group"><label>过去分词</label><input type="text" name="word_detail[past_participle]" value="<%= wordInflections.past_participle || '' %>"></div>
    <div class="form-group"><label>现在分词</label><input type="text" name="word_detail[present_participle]" value="<%= wordInflections.present_participle || '' %>"></div>
    <div class="form-group"><label>比较级</label><input type="text" name="word_detail[comparative]" value="<%= wordInflections.comparative || '' %>"></div>
    <div class="form-group"><label>最高级</label><input type="text" name="word_detail[superlative]" value="<%= wordInflections.superlative || '' %>"></div>
    <div class="form-group"><label>副词形式</label><input type="text" name="word_detail[adverb]" value="<%= wordInflections.adverb || '' %>"></div>
    <div class="form-group"><label>形容词形式</label><input type="text" name="word_detail[adjective]" value="<%= wordInflections.adjective || '' %>"></div>
    <div class="form-group"><label>名词形式</label><input type="text" name="word_detail[noun]" value="<%= wordInflections.noun || '' %>"></div>
  <% } %>

  <% if (item.type === 'phrase') { %>
    <h2>辨析题</h2>
    <% phraseRows.forEach((row, index) => { %>
      <div style="border:1px solid #ddd;padding:0.75rem;margin-bottom:1rem;border-radius:6px;">
        <input type="hidden" name="phrase_choice[<%= index %>][id]" value="<%= row.id %>">
        <div class="form-group"><label>题干句子</label><input type="text" name="phrase_choice[<%= index %>][prompt_sentence]" value="<%= row.prompt_sentence %>"></div>
        <div class="form-group"><label>正确短语</label><input type="text" name="phrase_choice[<%= index %>][correct_phrase]" value="<%= row.correct_phrase %>"></div>
        <div class="form-group"><label>干扰项 A</label><input type="text" name="phrase_choice[<%= index %>][distractor_a]" value="<%= row.distractor_a %>"></div>
        <div class="form-group"><label>干扰项 B</label><input type="text" name="phrase_choice[<%= index %>][distractor_b]" value="<%= row.distractor_b %>"></div>
        <div class="form-group"><label>干扰项 C</label><input type="text" name="phrase_choice[<%= index %>][distractor_c]" value="<%= row.distractor_c %>"></div>
        <div class="form-group"><label>解析</label><input type="text" name="phrase_choice[<%= index %>][explanation]" value="<%= row.explanation %>"></div>
        <% if (row.id) { %>
          <button type="submit" formaction="/admin/items/<%= item.id %>/phrase-choice-questions/<%= row.id %>/delete" class="btn">删除这道辨析题</button>
        <% } %>
      </div>
    <% }) %>
  <% } %>

  <% if (item.type === 'grammar') { %>
    <section class="form-section">
      <h2>语法知识结构</h2>
      <div class="form-group">
        <label>语法标题</label>
        <input type="text" name="grammar_detail[title]" value="<%= grammarDetailView.title || item.chinese || item.english || '' %>">
      </div>
      <div class="form-group">
        <label>语法说明</label>
        <textarea name="grammar_detail[description]" rows="4"><%= grammarDetailView.description || item.chinese || '' %></textarea>
      </div>
      <div class="form-group">
        <label>使用规则</label>
        <textarea name="grammar_detail[usage_notes]" rows="3"><%= grammarDetailView.usage_notes || '' %></textarea>
      </div>

      <h3>语法例题</h3>
      <% grammarRows.forEach((grammarExample, index) => { %>
        <div data-grammar-example-row style="border:1px solid #ddd;padding:0.75rem;margin-bottom:1rem;border-radius:6px;">
          <div class="form-group">
            <label>例题类型</label>
            <select name="grammar_examples[<%= index %>][example_type]">
              <option value="choice" <%= grammarExample.example_type === 'choice' ? 'selected' : '' %>>单项选择</option>
              <option value="completion" <%= grammarExample.example_type === 'completion' ? 'selected' : '' %>>完成句子</option>
              <option value="sentence_transform" <%= grammarExample.example_type === 'sentence_transform' ? 'selected' : '' %>>句型转换</option>
            </select>
          </div>
          <div class="form-group">
            <label>题干</label>
            <textarea name="grammar_examples[<%= index %>][prompt_text]" rows="3"><%= grammarExample.prompt_text || '' %></textarea>
          </div>
          <div class="form-group" data-grammar-options-field>
            <label>选项，每行一个，只有单项选择需要填写</label>
            <textarea name="grammar_examples[<%= index %>][options_text]" rows="4"><%= grammarExample.options_text || '' %></textarea>
          </div>
          <div class="form-group">
            <label>标准答案</label>
            <input type="text" name="grammar_examples[<%= index %>][answer_text]" value="<%= grammarExample.answer_text || '' %>">
          </div>
          <div class="form-group">
            <label>例题解析</label>
            <textarea name="grammar_examples[<%= index %>][explanation]" rows="3"><%= grammarExample.explanation || '' %></textarea>
          </div>
        </div>
      <% }) %>
    </section>

    <h2>连词成句兼容设置</h2>
    <div class="form-group"><label>答案句子</label><input type="text" name="sentence_order[answer_sentence]" value="<%= sentenceDetail.answer_sentence || '' %>"></div>
    <div class="form-group"><label>词块文本</label><input type="text" name="sentence_order[tokens_text]" value="<%= sentenceTokensText %>"></div>
    <div class="form-group"><label>提示文案</label><input type="text" name="sentence_order[hint_text]" value="<%= sentenceDetail.hint_text || '' %>"></div>
  <% } %>

  <button type="submit" class="btn btn-primary">保存</button>
  <a href="/admin/units/<%= unit.id %>/items" class="btn">取消</a>
</form>

<script>
(() => {
  function toggleGrammarOptionFields(root = document) {
    root.querySelectorAll('[data-grammar-example-row]').forEach((row) => {
      const typeSelect = row.querySelector('select[name$="[example_type]"]');
      const optionField = row.querySelector('[data-grammar-options-field]');
      if (!typeSelect || !optionField) return;

      const isChoice = typeSelect.value === 'choice';
      optionField.hidden = !isChoice;
      optionField.querySelectorAll('input, textarea, select').forEach((field) => {
        field.disabled = !isChoice;
        if (!isChoice) field.value = '';
      });
    });
  }

  document.addEventListener('change', (event) => {
    if (event.target.matches('select[name$="[example_type]"]')) {
      toggleGrammarOptionFields();
    }
  });

  toggleGrammarOptionFields();
})();
</script>
