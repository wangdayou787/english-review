<h1>学习统计</h1>

<div class="metric-grid">
  <section class="metric-card">
    <strong><%= totalScore %></strong>
    <span>总积分</span>
  </section>
  <section class="metric-card">
    <strong><%= consecutive %></strong>
    <span>连续打卡</span>
  </section>
  <section class="metric-card">
    <strong><%= accuracy %>%</strong>
    <span>总正确率</span>
  </section>
</div>

<h2 class="mb-1">已掌握条目（<%= knownItems.length %>）</h2>
<% if (knownItems.length > 0) { %>
  <div class="chip-list">
    <% knownItems.forEach(item => { %>
      <span class="mastery-chip">
        <%= item.english || item.chinese %>
      </span>
    <% }) %>
  </div>
<% } else { %>
  <p class="text-muted">暂无已掌握条目</p>
<% } %>

<p class="mt-2">
  <a href="/practice">&larr; 返回复习主页</a>
</p>
