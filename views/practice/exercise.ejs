<h1><%= title %></h1>
<p class="text-muted mb-1">
  共 <%= totalItems %> 题
  <% if (totalPages > 1) { %>(第 <%= page %> / <%= totalPages %> 页)<% } %>
</p>

<form
  id="exercise-form"
  method="POST"
  action="/practice/submit"
  data-answer-storage-key="<%= answerStorageKey || '' %>"
  data-page="<%= page %>"
  data-total-pages="<%= totalPages %>"
  data-total-items="<%= totalItems %>"
>
  <% if (typeof cycleType !== 'undefined' && cycleType) { %>
    <input type="hidden" name="cycle" value="<%= cycleType %>">
  <% } %>

  <% exercises.forEach((ex, idx) => { %>
    <article class="exercise-card">
      <div class="exercise-meta">
        <strong>第 <%= idx + 1 %> 题</strong>
        <span class="text-muted">
          <% if (ex.exercise_type === 'en2cn') { %>英译中
          <% } else if (ex.exercise_type === 'cn2en') { %>中译英
          <% } else if (ex.exercise_type === 'cn2en_choice') { %>中文选英文
          <% } else if (ex.exercise_type === 'en2cn_fill') { %>英译中填空
          <% } else if (ex.exercise_type === 'listening') { %>听音辨义
          <% } else if (ex.exercise_type === 'sentence') { %>连词成句
          <% } else if (ex.exercise_type === 'spelling_fill') { %>单词拼写填空
          <% } else if (ex.exercise_type === 'form_fill') { %>词形变换填空
          <% } else if (ex.exercise_type === 'phrase_choice') { %>短语单选辨析
          <% } else if (ex.exercise_type === 'sentence_plus') { %>连词成句增强版
          <% } else if (ex.exercise_type === 'grammar_choice') { %>语法单项选择
          <% } else if (ex.exercise_type === 'grammar_completion') { %>语法完成句子
          <% } else if (ex.exercise_type === 'grammar_sentence_transform') { %>语法句型转换
          <% } %>
        </span>
      </div>

      <% if (ex.instruction_text) { %>
        <p class="exercise-instruction"><%= ex.instruction_text %></p>
      <% } %>

      <div class="exercise-question"><%= ex.question %></div>

      <% if (ex.exercise_type === 'spelling_fill' && ex.first_letter_hint) { %>
        <p class="text-muted">首字母提示：<%= ex.first_letter_hint %></p>
      <% } %>

      <% if (ex.exercise_type === 'form_fill' && ex.prompt_label) { %>
        <p class="text-muted">目标词形：<%= ex.prompt_label %></p>
      <% } %>

      <% if (ex.exercise_type === 'form_fill' && ex.usage_note) { %>
        <p class="text-muted">用法说明：<%= ex.usage_note %></p>
      <% } %>

      <% if (ex.exercise_type === 'form_fill' && ex.example) { %>
        <p class="text-muted">例句：<%= ex.example %></p>
      <% } %>

      <% if (ex.exercise_type === 'listening') { %>
        <button type="button" class="btn btn-sm mb-1 js-speak" data-question="<%= ex.question %>"><%= ex.primary_action_text || '播放发音' %></button>
      <% } %>

      <input type="hidden" name="answers[<%= idx %>][item_id]" value="<%= ex.item_id %>">
      <input type="hidden" name="answers[<%= idx %>][exercise_type]" value="<%= ex.exercise_type %>">

      <% if (ex.options) { %>
        <% ex.options.forEach((opt, oi) => { %>
          <label class="choice-option">
            <input type="radio" name="answers[<%= idx %>][answer]" value="<%= opt %>" required>
            <span><%= String.fromCharCode(65 + oi) %>. <%= opt %></span>
          </label>
        <% }) %>
      <% } else if (ex.words && (ex.exercise_type === 'sentence' || ex.exercise_type === 'sentence_plus')) { %>
        <div id="sentence-<%= idx %>" class="sentence-order">
          <% ex.words.forEach(w => { %>
            <span class="word-chip" onclick="selectWord(this, <%= idx %>)"><%= w %></span>
          <% }) %>
        </div>
        <div id="sentence-result-<%= idx %>" class="sentence-result"></div>
        <input type="hidden" name="answers[<%= idx %>][answer]" id="sentence-input-<%= idx %>">
      <% } else { %>
        <input
          type="text"
          class="answer-input"
          name="answers[<%= idx %>][answer]"
          placeholder="输入你的答案"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          required
        >
      <% } %>
    </article>
  <% }) %>

  <div class="form-actions">
    <% if (page > 1) { %>
      <a href="?page=<%= page - 1 %><%= typeof cycleType !== 'undefined' && cycleType ? '&cycle=' + cycleType : '' %>" class="btn js-page-link">上一页</a>
    <% } else { %>
      <span></span>
    <% } %>
    <% if (page < totalPages) { %>
      <a href="?page=<%= page + 1 %><%= typeof cycleType !== 'undefined' && cycleType ? '&cycle=' + cycleType : '' %>" class="btn js-page-link">下一页</a>
    <% } else { %>
      <button
        type="submit"
        class="primary-action"
        data-final-submit
      >提交答案</button>
    <% } %>
  </div>
</form>

<script>
function speak(text) {
  if ('speechSynthesis' in window) {
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = 'en-US';
    utterance.rate = 0.85;
    speechSynthesis.speak(utterance);
  }
}

document.querySelectorAll('.js-speak').forEach(button => {
  button.addEventListener('click', () => speak(button.dataset.question || ''));
});

const exerciseForm = document.getElementById('exercise-form');
const answerStorageKey = exerciseForm ? exerciseForm.dataset.answerStorageKey : '';
const page = exerciseForm ? Number(exerciseForm.dataset.page || '1') : 1;
const totalPages = exerciseForm ? Number(exerciseForm.dataset.totalPages || '1') : 1;
const totalItems = exerciseForm ? Number(exerciseForm.dataset.totalItems || '0') : 0;

function readStoredAnswers() {
  if (!answerStorageKey || !window.sessionStorage) return {};
  try {
    return JSON.parse(sessionStorage.getItem(answerStorageKey) || '{}');
  } catch (err) {
    return {};
  }
}

function writeStoredAnswers(answers) {
  if (!answerStorageKey || !window.sessionStorage) return;
  sessionStorage.setItem(answerStorageKey, JSON.stringify(answers));
}

function getAnswerGroups() {
  const groups = new Map();
  document.querySelectorAll('[name^="answers["]').forEach(input => {
    const match = input.name.match(/^answers\[(\d+)\]\[(.+)\]$/);
    if (!match) return;
    const index = match[1];
    const field = match[2];
    if (!groups.has(index)) groups.set(index, {});
    groups.get(index)[field] = input;
  });
  return groups;
}

function getAnswerValue(fields) {
  if (!fields.answer) return '';
  if (fields.answer instanceof RadioNodeList) {
    return fields.answer.value || '';
  }
  if (fields.answer.type === 'radio') {
    const checked = document.querySelector(`[name="${fields.answer.name}"]:checked`);
    return checked ? checked.value : '';
  }
  return fields.answer.value || '';
}

function saveCurrentPageAnswers() {
  if (totalPages <= 1) return;
  const stored = readStoredAnswers();
  getAnswerGroups().forEach(fields => {
    if (!fields.item_id || !fields.exercise_type) return;
    stored[fields.item_id.value] = {
      item_id: fields.item_id.value,
      exercise_type: fields.exercise_type.value,
      answer: getAnswerValue(fields),
    };
  });
  writeStoredAnswers(stored);
}

function restoreCurrentPageAnswers() {
  if (totalPages <= 1) return;
  const stored = readStoredAnswers();
  getAnswerGroups().forEach(fields => {
    if (!fields.item_id) return;
    const saved = stored[fields.item_id.value];
    if (!saved || !fields.answer) return;
    if (fields.answer.type === 'radio') {
      document.querySelectorAll(`[name="${fields.answer.name}"]`).forEach(radio => {
        radio.checked = radio.value === saved.answer;
      });
    } else {
      fields.answer.value = saved.answer || '';
    }
  });
}

function appendHiddenInput(form, name, value) {
  const input = document.createElement('input');
  input.type = 'hidden';
  input.name = name;
  input.value = value || '';
  form.appendChild(input);
}

function appendStoredAnswersForSubmit(event) {
  if (!exerciseForm || totalPages <= 1) return;
  if (page === totalPages) {
    saveCurrentPageAnswers();
    const storedAnswers = Object.values(readStoredAnswers());
    if (storedAnswers.length < totalItems) {
      event.preventDefault();
      alert('请完成所有页面的题目后再提交。');
      return;
    }
    document.querySelectorAll('[name^="answers["]').forEach(input => {
      input.disabled = true;
    });
    storedAnswers.forEach((answer, index) => {
      appendHiddenInput(exerciseForm, `answers[${index}][item_id]`, answer.item_id);
      appendHiddenInput(exerciseForm, `answers[${index}][exercise_type]`, answer.exercise_type);
      appendHiddenInput(exerciseForm, `answers[${index}][answer]`, answer.answer);
    });
    setTimeout(() => sessionStorage.removeItem(answerStorageKey), 0);
  }
}

document.querySelectorAll('.js-page-link').forEach(link => {
  link.addEventListener('click', event => {
    event.preventDefault();
    if (exerciseForm && !exerciseForm.checkValidity()) {
      exerciseForm.reportValidity();
      return;
    }
    saveCurrentPageAnswers();
    window.location.href = link.href;
  });
});

if (exerciseForm) {
  restoreCurrentPageAnswers();
  exerciseForm.addEventListener('submit', appendStoredAnswersForSubmit);
}

function selectWord(el, idx) {
  const resultDiv = document.getElementById('sentence-result-' + idx);
  const hiddenInput = document.getElementById('sentence-input-' + idx);
  const word = el.textContent.trim();
  const current = hiddenInput.value ? hiddenInput.value.split(' ') : [];
  current.push(word);
  hiddenInput.value = current.join(' ');
  resultDiv.replaceChildren();
  current.forEach(w => {
    const chip = document.createElement('span');
    chip.textContent = w;
    resultDiv.appendChild(chip);
  });
  el.style.opacity = '0.4';
  el.style.pointerEvents = 'none';
}
</script>
