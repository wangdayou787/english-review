<h1><%= title %></h1>
<p class="text-muted mb-1">
  共 <%= totalItems %> 题
  <% if (totalPages > 1) { %>(第 <%= page %> / <%= totalPages %> 页)<% } %>
</p>

<form id="exercise-form" method="POST" action="/practice/submit">
  <% if (typeof cycleType !== 'undefined' && cycleType) { %>
    <input type="hidden" name="cycle" value="<%= cycleType %>">
  <% } %>

  <% exercises.forEach((ex, idx) => { %>
    <article class="exercise-card">
      <div class="exercise-meta">
        <strong>第 <%= idx + 1 %> 题</strong>
        <span class="text-muted">
          <% if (ex.exercise_type === 'en2cn') { %>英译中
          <% } else if (ex.exercise_type === 'cn2en') { %>中译英
          <% } else if (ex.exercise_type === 'cn2en_choice') { %>中文选英文
          <% } else if (ex.exercise_type === 'en2cn_fill') { %>英译中填空
          <% } else if (ex.exercise_type === 'listening') { %>听音辨义
          <% } else if (ex.exercise_type === 'sentence') { %>连词成句
          <% } else if (ex.exercise_type === 'spelling_fill') { %>单词拼写填空
          <% } else if (ex.exercise_type === 'form_fill') { %>词形变换填空
          <% } else if (ex.exercise_type === 'phrase_choice') { %>短语单选辨析
          <% } else if (ex.exercise_type === 'sentence_plus') { %>连词成句增强版
          <% } %>
        </span>
      </div>

      <% if (ex.instruction_text) { %>
        <p class="exercise-instruction"><%= ex.instruction_text %></p>
      <% } %>

      <div class="exercise-question"><%= ex.question %></div>

      <% if (ex.exercise_type === 'spelling_fill' && ex.first_letter_hint) { %>
        <p class="text-muted">首字母提示：<%= ex.first_letter_hint %></p>
      <% } %>

      <% if (ex.exercise_type === 'form_fill' && ex.prompt_label) { %>
        <p class="text-muted">目标词形：<%= ex.prompt_label %></p>
      <% } %>

      <% if (ex.exercise_type === 'form_fill' && ex.usage_note) { %>
        <p class="text-muted">用法说明：<%= ex.usage_note %></p>
      <% } %>

      <% if (ex.exercise_type === 'form_fill' && ex.example) { %>
        <p class="text-muted">例句：<%= ex.example %></p>
      <% } %>

      <% if (ex.exercise_type === 'listening') { %>
        <button type="button" class="btn btn-sm mb-1 js-speak" data-question="<%= ex.question %>"><%= ex.primary_action_text || '播放发音' %></button>
      <% } %>

      <input type="hidden" name="answers[<%= idx %>][item_id]" value="<%= ex.item_id %>">
      <input type="hidden" name="answers[<%= idx %>][exercise_type]" value="<%= ex.exercise_type %>">

      <% if (ex.options) { %>
        <% ex.options.forEach((opt, oi) => { %>
          <label class="choice-option">
            <input type="radio" name="answers[<%= idx %>][answer]" value="<%= opt %>" required>
            <span><%= String.fromCharCode(65 + oi) %>. <%= opt %></span>
          </label>
        <% }) %>
      <% } else if (ex.words && (ex.exercise_type === 'sentence' || ex.exercise_type === 'sentence_plus')) { %>
        <div id="sentence-<%= idx %>" class="sentence-order">
          <% ex.words.forEach(w => { %>
            <span class="word-chip" onclick="selectWord(this, <%= idx %>)"><%= w %></span>
          <% }) %>
        </div>
        <div id="sentence-result-<%= idx %>" class="sentence-result"></div>
        <input type="hidden" name="answers[<%= idx %>][answer]" id="sentence-input-<%= idx %>">
      <% } else { %>
        <input type="text" class="answer-input" name="answers[<%= idx %>][answer]" placeholder="输入你的答案" required>
      <% } %>

      <% if (ex.hint_text) { %>
        <p class="exercise-hint"><%= ex.hint_text %></p>
      <% } %>
    </article>
  <% }) %>

  <div class="form-actions">
    <% if (page < totalPages) { %>
      <a href="?page=<%= page + 1 %><%= typeof cycleType !== 'undefined' && cycleType ? '&cycle=' + cycleType : '' %>" class="btn">下一页</a>
    <% } else { %>
      <span></span>
    <% } %>
    <button type="submit" class="primary-action">提交答案</button>
  </div>
</form>

<script>
function speak(text) {
  if ('speechSynthesis' in window) {
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = 'en-US';
    utterance.rate = 0.85;
    speechSynthesis.speak(utterance);
  }
}

document.querySelectorAll('.js-speak').forEach(button => {
  button.addEventListener('click', () => speak(button.dataset.question || ''));
});

function selectWord(el, idx) {
  const resultDiv = document.getElementById('sentence-result-' + idx);
  const hiddenInput = document.getElementById('sentence-input-' + idx);
  const word = el.textContent.trim();
  const current = hiddenInput.value ? hiddenInput.value.split(' ') : [];
  current.push(word);
  hiddenInput.value = current.join(' ');
  resultDiv.replaceChildren();
  current.forEach(w => {
    const chip = document.createElement('span');
    chip.textContent = w;
    resultDiv.appendChild(chip);
  });
  el.style.opacity = '0.4';
  el.style.pointerEvents = 'none';
}
</script>
