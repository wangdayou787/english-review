<h1>复习主页</h1>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>

<% if (!hasItems) { %>
  <div class="alert alert-error">暂无复习内容，请联系管理员添加单词和短语。</div>
<% } else { %>
  <div class="metric-grid">
    <section class="metric-card">
      <strong><%= consecutive %></strong>
      <span>连续打卡天数</span>
    </section>
    <section class="metric-card">
      <strong><%= totalScore %></strong>
      <span>累计积分</span>
    </section>
  </div>

  <h2 class="mb-1">今日进度</h2>
  <section class="panel progress-list mb-2">
    <div class="progress-row">
      <strong>单词：</strong><%= checkIn.words_done || 0 %> / <%= config.daily_words %> 
      <progress value="<%= checkIn.words_done || 0 %>" max="<%= config.daily_words %>"></progress>
    </div>
    <div class="progress-row">
      <strong>短语：</strong><%= checkIn.phrases_done || 0 %> / <%= config.daily_phrases %>
      <progress value="<%= checkIn.phrases_done || 0 %>" max="<%= config.daily_phrases %>"></progress>
    </div>
    <div class="progress-row">
      <strong>语法：</strong><%= checkIn.grammar_done || 0 %> / <%= config.daily_grammar %>
      <progress value="<%= checkIn.grammar_done || 0 %>" max="<%= config.daily_grammar %>"></progress>
    </div>
  </section>

  <a href="/practice/start" class="primary-action mb-2">开始今日复习</a>

  <% if (activeCycles.length > 0) { %>
    <h2 class="mb-1 mt-2">周期复习提醒</h2>
    <div class="reminder-list">
      <% activeCycles.forEach(c => { %>
        <div class="reminder-row">
          <span>📅 <%= c.cycle_type === 'weekly' ? '本周' : c.cycle_type === 'biweekly' ? '双周' : '本月' %>复习日 — 建议完成周期全覆盖复习</span>
          <a href="/practice/start?cycle=<%= c.cycle_type %>" class="btn btn-sm btn-primary">开始复习</a>
        </div>
      <% }) %>
    </div>
  <% } %>
<% } %>

<p class="mt-2"><a href="/stats">📊 查看学习统计</a></p>
