<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : '英语复习工具' %></title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/review.css">
</head>
<body>
  <nav>
    <div class="nav-brand">
      <a href="/">📚 英语复习工具</a>
    </div>
    <div class="nav-links">
      <% if (user) { %>
        <% if (user.role === 'admin') { %>
          <a href="/admin/textbooks">课本管理</a>
          <a href="/admin/review-plan">复习计划</a>
          <a href="/practice">学生端预览</a>
          <a href="/admin/settings">系统设置</a>
        <% } else { %>
          <a href="/practice">开始复习</a>
          <a href="/stats">学习统计</a>
        <% } %>
        <span class="nav-user"><%= user.username %></span>
        <a href="/logout">退出</a>
      <% } %>
    </div>
  </nav>
  <main>
    <%- body %>
  </main>
</body>
</html>
