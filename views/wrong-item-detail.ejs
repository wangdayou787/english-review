<h1>错题详情</h1>

<p class="mb-2">
  <a href="/wrong-items" class="btn">返回错题本</a>
  <a href="/practice/wrong" class="btn btn-primary">开始错题专项复习</a>
</p>

<section class="panel mb-2">
  <div class="flex-between">
    <div>
      <span class="status-pill status-planned">
        <%= wrongItem.type === 'word' ? '单词' : wrongItem.type === 'phrase' ? '短语' : '语法' %>
      </span>
      <h2 class="mt-2"><%= wrongItem.english || wrongItem.chinese || '-' %></h2>
      <p class="text-muted"><%= wrongItem.chinese && wrongItem.english ? wrongItem.chinese : (wrongItem.english || '-') %></p>
      <% if (wrongItem.pos) { %>
        <p class="text-muted">词性：<%= wrongItem.pos %></p>
      <% } %>
      <% if (wrongItem.example) { %>
        <p class="text-muted">例句：<%= wrongItem.example %></p>
      <% } %>
    </div>
    <div class="wrong-item-meta">
      <strong><%= wrongItem.wrong_count %></strong>
      <span>错误次数</span>
    </div>
  </div>
</section>

<section class="panel mb-2">
  <h2 class="mb-1">最近错误</h2>
  <p>你的答案：<strong><%= wrongItem.last_user_answer || '-' %></strong></p>
  <p>题型：<%= wrongItem.last_exercise_type || '-' %></p>
  <p class="text-muted">时间：<%= wrongItem.last_wrong_at || '-' %></p>
</section>

<section class="panel mb-2">
  <h2 class="mb-1">正确答案</h2>
  <% if (answerMetadata && answerMetadata.correct_answer) { %>
    <p><strong><%= answerMetadata.correct_answer %></strong></p>
  <% } else { %>
    <p class="text-muted">暂无可显示的正确答案。</p>
  <% } %>
  <% if (answerMetadata && answerMetadata.explanation) { %>
    <h3>解析</h3>
    <p class="text-muted"><%= answerMetadata.explanation %></p>
  <% } %>
</section>

<section class="panel">
  <h2 class="mb-1">最近作答记录</h2>
  <% if (history.length === 0) { %>
    <p class="text-muted">暂无作答记录。</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>时间</th>
          <th>题型</th>
          <th>你的答案</th>
          <th>结果</th>
        </tr>
      </thead>
      <tbody>
        <% history.forEach(record => { %>
          <tr>
            <td><%= record.created_at || '-' %></td>
            <td><%= record.exercise_type || '-' %></td>
            <td><%= record.user_answer || '-' %></td>
            <td>
              <span class="status-pill <%= record.is_correct ? 'status-available' : 'status-planned' %>">
                <%= record.is_correct ? '正确' : '错误' %>
              </span>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>
